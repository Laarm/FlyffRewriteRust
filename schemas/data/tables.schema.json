    "Teleport16Row": {
      "description": "One entry of `teleport16.inc` (the 16-level teleporter window).",
      "properties": {
        "boss": {
          "description": "The boss mover (0 = none).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "boss_drops": {
          "description": "The boss drops the window shows (empty until `propMoverEx` is loaded).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "class": {
          "description": "The class column.",
