        "equip_drop_max": {
          "description": "`nEquipDorpMax`.",
          "format": "int32",
          "type": "integer"
        },
        "equip_drop_min": {
          "description": "`nEquipDorpMin`.",
          "format": "int32",
          "type": "integer"
        },
        "fly": {
          "description": "`nFly`.",
          "format": "int32",
          "type": "integer"
        },
        "guard_attack": {
          "description": "`nGuardAttack`.",
          "format": "int32",
          "type": "integer"
        },
        "inven_drop_max": {
          "description": "`nInvenDorpMax`.",
          "format": "int32",
          "type": "integer"
        },
        "inven_drop_min": {
          "description": "`nInvenDorpMin`.",
          "format": "int32",
          "type": "integer"
        },
        "max": {
          "description": "`dwPropensityMax`.",
          "format": "int32",
          "type": "integer"
        },
        "min": {
          "description": "`dwPropensityMin`.",
          "format": "int32",
          "type": "integer"
        },
        "shop": {
          "description": "`nShop`.",
          "format": "int32",
          "type": "integer"
        },
        "step": {
          "description": "The step (map key).",
          "format": "int32",
          "type": "integer"
        },
        "vendor": {
          "description": "`nVendor`.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "step",
        "min",
        "max",
        "equip_drop_min",
        "equip_drop_max",
        "inven_drop_min",
        "inven_drop_max",
        "shop",
        "bank",
        "fly",
        "guard_attack",
        "vendor"
      ],
      "type": "object"
    },
    "SetItemAvail": {
      "description": "One row of `Setitem`: `Acc Block HPRate AtkRate Stats` for `+1 ..= +10`.",
      "properties": {
        "added": {
          "description": "`nAdded`.",
          "format": "int32",
          "type": "integer"
        },
        "attack_power_rate": {
          "description": "`nAttackPowerRate` (custom 4th column, `__BETTER_ARMOR_BONUS`).",
          "format": "int32",
          "type": "integer"
        },
        "block": {
          "description": "`nBlock`.",
          "format": "int32",
          "type": "integer"
        },
        "hit_rate": {
          "description": "`nHitRate`.",
          "format": "int32",
          "type": "integer"
        },
        "max_hit_point_rate": {
          "description": "`nMaxHitPointRate`.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "hit_rate",
        "block",
        "max_hit_point_rate",
        "attack_power_rate",
        "added"
      ],
      "type": "object"
    },
    "SkillPointCosts": {
      "description": "The skill-point costs of `Constant.inc` per skill kind.",
      "properties": {
        "expert_sp": {
          "description": "`JTYPE_EXPERT` (default 2).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pro_sp": {
          "description": "Every other job type (default 3).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "vag_sp": {
          "description": "`JTYPE_BASE` (default 1).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "vag_sp",
        "expert_sp",
        "pro_sp"
      ],
      "type": "object"
    },
    "TablesBundle": {
      "description": "`tables`: the small rule tables the client needs.",
      "properties": {
        "constants": {
          "$ref": "#/$defs/SkillPointCosts",
          "description": "The skill-point costs."
        },
        "couple": {
          "$ref": "#/$defs/CoupleSection",
          "description": "The couple tables."
        },
        "emotes": {
          "description": "The emote icons (`propMotion.txt`).",
          "items": {
            "$ref": "#/$defs/MotionProp"
          },
          "type": "array"
        },
        "exp": {
          "$ref": "#/$defs/ExpSection",
          "description": "The experience tables."
        },
        "generic_events": {
          "description": "The generic event titles and times.",
          "items": {
            "$ref": "#/$defs/GenericEventRow"
          },
          "type": "array"
        },
        "guild": {
          "$ref": "#/$defs/GuildSection",
          "description": "The guild tables."
        },
