            "$ref": "#/$defs/JobItemsRow"
          },
          "type": "array"
        },
        "jobs": {
          "description": "The jobs.",
          "items": {
            "$ref": "#/$defs/JobRow"
          },
          "type": "array"
        },
        "lord_events": {
          "$ref": "#/$defs/LordEventTables",
