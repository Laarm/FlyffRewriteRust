        },
        "lord_skills": {
          "description": "The lord skills.",
          "items": {
            "$ref": "#/$defs/LordSkill"
          },
          "type": "array"
        },
        "pk": {
          "$ref": "#/$defs/PkSection",
          "description": "The PK settings."
        },
        "structures": {
          "additionalProperties": false,
          "description": "`SRT_*` to the structure name.",
          "patternProperties": {
            "^\\d+$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "teleports16": {
          "description": "`teleport16.inc`.",
          "items": {
            "$ref": "#/$defs/Teleport16Row"
          },
          "type": "array"
        }
      },
      "required": [
        "jobs",
        "job_items",
        "constants",
        "exp",
        "guild",
        "couple",
        "pk",
        "emotes",
        "structures",
        "guild_appellations",
        "teleports16",
        "lord_skills",
        "generic_events",
        "lord_events"
