      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`model-bounds.<h16>.json`: the envelope of the `model-bounds` bundle (schema version 1).",
  "properties": {
    "bundle": {
      "const": "model-bounds"
    },
    "data": {
      "$ref": "#/$defs/ModelBoundsBundle"
