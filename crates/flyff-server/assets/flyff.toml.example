[gm]
## GM grants that override the database authority (D5, PL-036). Evaluated in order, the last
## matching entry wins.
## Values: entries {account | character | ip, level}. Owner: doc 23. Restart required.
## Example (exactly one of account / character / ip per entry; level is a letter F..P, an AUTH_* token
## or player / logchat / journalist / helper / gm1 / gm2 / gm3 / operator / admin):
##   [[gm.grants]]
##   account = "test"
##   level = "admin"
##   [[gm.grants]]
##   character = "Tester"
##   level = "gm3"
# grants = []
