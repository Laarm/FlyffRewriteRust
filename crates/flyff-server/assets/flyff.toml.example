# Flyff V15 server configuration (flyff.toml).
#
# Every key is optional: an empty file (or a file with everything commented out) reproduces this repack,
# and later changes of a default take effect after an upgrade. Lines of the form "# key = value" show the
# built-in default; remove the leading "# " to change a value.
#
# Precedence (later wins): built-in defaults, this file, environment variables FLYFF__SECTION__KEY
# (for example FLYFF__NET__BIND=127.0.0.1:9000; arrays as TOML: FLYFF__NET__ALLOWED_ORIGINS='["http://a:1"]'),
# command-line flags (--bind, --resource, --dev). Rates and events can also be changed live by GMs and
# are then remembered in the database (runtime_override). Unknown keys are errors; retired keys are warnings.
# `flyff config show` prints the effective values and where they came from; `flyff config default`
# prints this file.
#
# Generated by `cargo xtask config-docs` from the key tables of docs 03, 10 and 13: do not edit by hand.

[server]
## Server name in HelloAck.server_name and /api/bootstrap (replaces the SRVR_LIST entry).
## Values: 1..=32 characters. Owner: doc 10. Restart required.
# name = "V15"
## Countdown in seconds for SIGTERM/SIGINT/console shutdown.
## Values: 0..=3600. Owner: doc 10. Applied by reload without a restart.
# shutdown_countdown_s = 60
## Time zone of the wall-clock schedules and Lua os.date (PD-08).
## Values: "local" or an IANA zone such as "Europe/Berlin". Owner: doc 10. Restart required.
# timezone = "local"

[net]
## The one TCP port: HTTP, assets, /api and the WebSocket /ws (D3). --bind overrides.
## Values: socket address. Owner: doc 10. Restart required.
# bind = "0.0.0.0:8080"
## Snapshot flush cadence in ms; ticks = max(1, round(ms * 15 / 1000)); 200 = the original server
## (PL-020).
## Values: 67..=1000. Owner: doc 10. Restart required.
# flush_interval_ms = 67
## Largest accepted client-to-server WebSocket message (GP-01, __SO1014).
## Values: 1024..=65536. Owner: doc 10. Restart required.
# max_client_msg_bytes = 8192
## true: a malformed or empty envelope kicks with PROTOCOL_ERROR; false: dropped and counted
## (debugging only).
## Owner: doc 11. Restart required.
# strict_decode = true
## Per-session token bucket rate (GP-03).
## Values: 1..=10000. Owner: doc 11. Restart required.
# client_msgs_per_sec = 60
## Per-session token bucket capacity.
## Values: >= client_msgs_per_sec. Owner: doc 11. Restart required.
# client_msgs_burst = 120
## Kick when drops within 10 s exceed factor x rate; 0 = never.
## Owner: doc 11. Restart required.
# rate_kick_factor = 10
## A server batch larger than this is split at message boundaries.
## Values: 16384..=16777216. Owner: doc 11. Restart required.
# max_batch_bytes = 1048576
## Per-session queue of encoded frames (C2).
## Values: 16..=4096. Owner: doc 11. Restart required.
# outbound_queue_frames = 256
## Queued bytes per session before SlowConsumer.
## Values: >= max_batch_bytes. Owner: doc 11. Restart required.
# outbound_queue_bytes = 4194304
## Reserved: true logs a warning 'not supported' until a WP implements it.
## Owner: doc 11. Restart required.
# ws_permessage_deflate = false
## WebSocket ping cadence in seconds.
## Values: 5..=60. Owner: doc 11. Restart required.
# ws_ping_interval_s = 15
## Liveness timeout in seconds.
## Values: > ws_ping_interval_s. Owner: doc 11. Restart required.
# ws_idle_timeout_s = 60
## Seconds from upgrade to a valid Hello.
## Values: 5..=120. Owner: doc 11. Restart required.
# timeout_hello_s = 20
## Seconds from an accepted EnterWorld to Join.
## Values: 10..=600. Owner: doc 11. Restart required.
# timeout_entering_s = 60
## Character-select idle kick in seconds; 0 = off.
## Owner: doc 11. Restart required.
# timeout_charselect_idle_s = 900
## Extra WebSocket/API origins besides the serving host.
## Values: origins scheme://host[:port]. Owner: doc 11. Applied by reload without a restart.
# allowed_origins = []
## Per-IP WebSocket upgrade bucket rate (GP-02).
## Values: 1..=1000. Owner: doc 11. Restart required.
# upgrade_per_ip_per_sec = 10
## Per-IP WebSocket upgrade bucket capacity.
## Values: >= upgrade_per_ip_per_sec. Owner: doc 11. Restart required.
# upgrade_per_ip_burst = 50
## Open WebSockets per IP (IPv6: per /64); 0 = unlimited.
## Owner: doc 11. Restart required.
# max_conns_per_ip = 16
## Blocked client networks (403 on every route; loopback is never blocked; replaces IPCut.ini,
## F-007).
## Values: CIDR networks. Owner: doc 10. Applied by reload without a restart.
# ip_block = []
## MoverKeyframe cadence for moving NPCs; 0 = off (PL-008).
## Values: 0..=15. Owner: doc 10. Restart required.
# npc_keyframe_hz = 1

[net.tls]
## Certificate chain (PEM) for built-in TLS (rustls); with key, enables HTTP/2 via ALPN. Empty =
## plain HTTP.
## Values: readable PEM. Owner: doc 10. Restart required.
# cert = ""
## Private key (PEM) for built-in TLS.
## Values: readable PEM. Owner: doc 10. Restart required.
# key = ""
## Certificate reload polling interval in seconds; 0 = never.
## Values: 0 or 5..=86400. Owner: doc 24. Restart required.
# reload_check_s = 60

[auth]
## Session token validity after the last socket closed.
## Values: >= gameplay.timewait_close_s + 10. Owner: doc 12. Restart required.
# token_grace_s = 60
## Wait for the old claim's release on a forced login.
## Values: >= timewait_close_s + ceil(database.flush_wait_timeout_ms / 1000). Owner: doc 12.
## Restart required.
# takeover_wait_s = 20
## NEUZ_PHASH salt of the browser md5 (D3).
## Owner: doc 12. Restart required.
# legacy_md5_salt = "kikugalanet"
## Allow /api/register (PD-05).
## Owner: doc 12. Applied by reload without a restart.
# allow_registration = true
## Reserved (F-053): true warns and behaves as false.
## Owner: doc 12. Restart required.
# second_password = false
## Character deletion needs the account password (PL-035).
## Owner: doc 12. Applied by reload without a restart.
# delete_requires_password = true
## Legacy AccountServer MAX_CONN (error 108).
## Values: 1..=1000000. Owner: doc 12. Restart required.
# max_online_accounts = 50000
## Legacy channel lMax: Hello is refused with SERVER_FULL above this many in-world players.
## Values: 1..=100000. Owner: doc 12. Applied by reload without a restart.
# max_in_world = 1000
## Registrations per client IP per rolling hour (PD-05); 0 = unlimited.
## Owner: doc 12. Applied by reload without a restart.
# register_per_ip_per_hour = 5
## Only GMs and allow-listed IPs may log in (F-006).
## Owner: doc 12. Applied by reload without a restart.
# maintenance = false
## IPs allowed to log in during maintenance.
## Values: IP or CIDR. Owner: doc 12. Applied by reload without a restart.
# maintenance_allow_ips = []

[web]
## Serve /res and /gen without login (D6, PD-09). Keep the server on a private network: the assets
## are proprietary.
## Owner: doc 24. Restart required.
# public_assets = true
## HTML title of the client (NEUZ_TITLE).
## Values: 1..=64 characters. Owner: doc 24. Restart required.
# page_title = "[VS22] V15"
## Optional registration link on the login screen.
## Values: empty or URL. Owner: doc 24. Restart required.
# register_url = ""
## Sliding validity of the asset cookie.
## Values: 60..=604800. Owner: doc 24. Restart required.
# asset_cookie_ttl_s = 43200
## Peers whose X-Forwarded-* headers are trusted: the only client-IP rule.
## Values: CIDR networks. Owner: doc 24. Restart required.
# trusted_proxies = []
## Accept-level connection cap per IP; 0 = unlimited.
## Owner: doc 24. Restart required.
# max_tcp_per_ip = 64
## Accept-level connection cap; 0 = unlimited.
## Owner: doc 24. Restart required.
# max_tcp_total = 8192
## Static-asset request rate per IP; 0 = class off.
## Owner: doc 24. Restart required.
# req_per_ip_per_sec = 300
## Static-asset burst per IP.
## Values: >= req_per_ip_per_sec. Owner: doc 24. Restart required.
# req_per_ip_burst = 2000
## API request rate per IP (/api/login, /api/register); 0 = class off.
## Owner: doc 24. Restart required.
# api_per_ip_per_sec = 5
## API burst per IP.
## Values: >= api_per_ip_per_sec. Owner: doc 24. Restart required.
# api_per_ip_burst = 30
## Concurrent /gen cache-miss waits per IP; 0 = unlimited.
## Owner: doc 24. Restart required.
# gen_waits_per_ip = 8
## HSTS max-age on TLS; 0 = off.
## Owner: doc 24. Restart required.
# hsts_max_age_s = 0
## Emit the Content-Security-Policy header.
## Owner: doc 24. Restart required.
# csp = true

[assets]
## Build derived assets in the background after start.
## Owner: doc 24. Restart required.
# prewarm = true
## Pre-compressed gzip variants of raw files.
## Values: "all" | "lazy" | "off". Owner: doc 24. Restart required.
# gzip_raw = "all"
## Budget of cache/ in MB (reported by `flyff check`); optional assets are refused above it.
## Values: 100..=100000. Owner: doc 24. Restart required.
# disk_budget_mb = 4096
## Seconds a /gen request waits for a build before 503.
## Values: 1..=600. Owner: doc 24. Restart required.
# interactive_timeout_s = 30
## Fingerprint inputs: file stats or content.
## Values: "stat" | "content". Owner: doc 24. Restart required.
# fingerprint_mode = "stat"
## Per-land and per-skeleton pack endpoints (M8).
## Values: "on" | "off". Owner: doc 24. Restart required.
# packs = "off"
## Shared-pack threshold in lands.
## Values: 1..=1000. Owner: doc 24. Restart required.
# pack_shared_min_lands = 8

[paths]
## The original data (never written, D6); --resource and FLYFF_RESOURCE override.
## Values: not empty. Owner: doc 10. Restart required.
# resource_dir = "Resource"
## Files that shadow Resource/.
## Values: not empty. Owner: doc 10. Restart required.
# overrides_dir = "overrides"
## Transpiled NPC dialogs (restored from the embedded copy when missing).
## Values: not empty. Owner: doc 10. Restart required.
# npc_scripts_dir = "scripts/npc"
## Derived assets (deletable).
## Values: not empty. Owner: doc 10. Restart required.
# cache_dir = "cache"

[data]
## Error diagnostics of the data loader fail the start.
## Owner: doc 14. Restart required.
# strict = false
## Replace non-CP1252 characters by '?' as the original did (PL-132).
## Owner: doc 14. Restart required.
# cp1252_lossy = false

[runtime]
## tokio worker threads; 0 = max(1, cores - 1).
## Values: 0..=256. Owner: doc 10. Restart required.
# io_threads = 0
## Asset-preparation pool size; 0 = max(1, cores - 2).
## Values: 0..=64. Owner: doc 10. Restart required.
# asset_threads = 0
## Niceness of the asset threads.
## Values: 0..=19. Owner: doc 10. Restart required.
# asset_nice = 10
## Temporary start-up pool; 0 = all cores.
## Values: 0..=256. Owner: doc 10. Restart required.
# startup_threads = 0

[log]
## Console and file filter; RUST_LOG wins when set.
## Values: tracing filter, e.g. "info,flyff_game=debug". Owner: doc 10. Applied by reload without a
## restart.
# level = "info"
## File format (the console is always text).
## Values: "text" | "json". Owner: doc 10. Restart required.
# format = "text"
## stderr output: auto = ANSI when stderr is a TTY, plain, off.
## Values: "auto" | "plain" | "off". Owner: doc 10. Restart required.
# console = "auto"
## Directory of flyff.log and the rotated files.
## Values: not empty. Owner: doc 10. Restart required.
# dir = "logs"
## Rotate flyff.log above this size (it also rotates at UTC midnight).
## Values: 1..=4096. Owner: doc 10. Restart required.
# file_max_mib = 64
## Rotated files kept.
## Values: 1..=1000. Owner: doc 10. Restart required.
# file_keep = 20
## Rotated files older than this are deleted.
## Values: 1..=3650. Owner: doc 10. Restart required.
# max_age_days = 30
## Client-caused WARN lines per session per minute; 0 = unlimited.
## Owner: doc 10. Applied by reload without a restart.
# client_warn_per_min = 10

[admin]
## Non-loopback access to /metrics, /admin and /admin/api/* (still needs the bearer token in
## data/admin.token).
## Owner: doc 10. Restart required.
# allow_remote = false
## stdin admin console: auto = only on a TTY, stdin = always (systemd with a pipe), off.
## Values: "auto" | "stdin" | "off". Owner: doc 10. Restart required.
# console = "auto"
## A loopback request without a valid session acts as the owner (ADMINISTRATOR); false: even the
## host needs a staff login or the token (Plan/25 §1.1).
## Owner: doc 25. Restart required.
# owner_loopback = true
## Staff sessions: accounts with an authority of L or higher sign in at /admin (UD-19).
## Owner: doc 25. Restart required.
# staff_login = true
## Idle timeout of an admin session in minutes.
## Values: 1..=1440. Owner: doc 25. Applied by reload without a restart.
# session_idle_min = 30
## Absolute lifetime of an admin session in hours.
## Values: 1..=720. Owner: doc 25. Applied by reload without a restart.
# session_max_h = 12
## Remote staff sign-ins to the admin console need a TOTP code; staff without one enrolled sign in
## only from the host (Plan/25 §1.3).
## Owner: doc 25. Applied by reload without a restart.
# totp_required = false
## Per-capability overrides of the minimum authority letter of the admin console (Plan/25 §1.6),
## e.g. "act.kick" = "N".
## Values: capability name = authority letter L..P, never below L. Owner: doc 25. Restart required.
# capabilities = {}
## One-click reason presets of the admin console (kick, mute, ban, grants, removals, ...).
## Values: 1..=32 entries of 1..=32 characters. Owner: doc 25. Applied by reload without a restart.
# reason_presets = ["Spam", "Abuse", "Botting", "RMT", "Exploit", "Impersonation", "Support", "Event", "Other"]
## Largest group action (targets per request); more answers 413 too_many_targets.
## Values: 1..=10000. Owner: doc 25. Applied by reload without a restart.
# max_objects_per_action = 500
## Mutating admin API requests per identity and second (token bucket); more answers 429
## rate_limited.
## Values: 1..=10000. Owner: doc 25. Applied by reload without a restart.
# mutations_per_s = 30
## A penya change above this needs a typed confirmation.
## Owner: doc 25. Applied by reload without a restart.
# confirm_gold_threshold = 100000000
## More items than this in one action need a typed confirmation.
## Values: 1..=100000. Owner: doc 25. Applied by reload without a restart.
# confirm_item_threshold = 50
## Admin WebSockets (console tabs) one identity may hold open at once; more answers 429 limit.
## Values: 1..=64. Owner: doc 25. Applied by reload without a restart.
# max_ws_per_identity = 4
## Map subscriptions per admin WebSocket; more answers SubscriptionError LIMIT.
## Values: 1..=16. Owner: doc 25. Applied by reload without a restart.
# max_map_subs_per_conn = 1
## Map subscriptions across all admin WebSockets; more answers SubscriptionError LIMIT.
## Values: 1..=1024. Owner: doc 25. Applied by reload without a restart.
# max_map_subs_total = 16
## Live map: a subscription rectangle up to this size (metres, the larger side) gets tier A, every
## enabled entity at 5 Hz.
## Values: 100..=100000, <= map_tier_b_m. Owner: doc 25. Applied by reload without a restart.
# map_tier_a_m = 1200
## Live map: a rectangle up to this size gets tier B (players, monsters, NPCs at about 1.9 Hz); a
## larger one tier C (players, bosses and 128 m bins at 0.5 Hz).
## Values: 100..=100000. Owner: doc 25. Applied by reload without a restart.
# map_tier_b_m = 6000
## Live map: entity reads per game tick across all admin map subscriptions (a cell visit costs
## 1/16); a frame that does not fit continues on the next tick.
## Values: 100..=100000000. Owner: doc 25. Applied by reload without a restart.
# map_visit_budget = 30000
## Live map: a tier A or B frame with more entities than this is sent as tier C and flagged
## degraded.
## Values: 100..=1000000. Owner: doc 25. Applied by reload without a restart.
# map_max_entities = 4000
## Allow the P-level backup download of the admin console from a non-loopback peer (Plan/25 §9.7);
## false: loopback only.
## Owner: doc 25. Applied by reload without a restart.
# allow_backup_download_remote = false

[admin.alerts]
## Dashboard alert: the tick p99 stays above this many milliseconds (Plan/25 §9.1).
## Values: 1..=1000. Owner: doc 25. Applied by reload without a restart.
# tick_p99_ms = 60
## Dashboard alert: how long the tick p99 must stay above the limit before the alert fires.
## Values: 10..=3600. Owner: doc 25. Applied by reload without a restart.
# tick_p99_for_s = 60
## Dashboard alert: the newest backup is older than this many hours; 0 = off.
## Values: 0 or 1..=8760. Owner: doc 25. Applied by reload without a restart.
# backup_max_age_h = 26
## Dashboard alert: the free space of the data directory is below this many GB; 0 = off.
## Values: 0 or 1..=100000. Owner: doc 25. Applied by reload without a restart.
# disk_min_gb = 2
## Dashboard alert: more than this many failed remote staff logins within failed_logins_window_min.
## Values: 1..=100000. Owner: doc 25. Applied by reload without a restart.
# failed_logins = 5
## Window of the failed staff login alert in minutes.
## Values: 1..=1440. Owner: doc 25. Applied by reload without a restart.
# failed_logins_window_min = 10

[debug]
## Record every game-thread input for `flyff replay`.
## Owner: doc 10. Restart required.
# record_inputs = false
## One sub-directory per recorded run.
## Values: not empty. Owner: doc 10. Restart required.
# replay_dir = "logs/replay"
## Recording stops (with a warning) at this compressed size.
## Owner: doc 10. Restart required.
# replay_max_mib = 2048
## State digest cadence in the replay log; 0 = never.
## Owner: doc 10. Restart required.
# digest_every_ticks = 15
## Game RNG seed; 0 = random from the OS at every start.
## Owner: doc 10. Restart required.
# seed = 0
## Serve the /dev/* surfaces without --dev.
## Owner: doc 10. Restart required.
# dev_surfaces = false

[database]
## SQLite database file, relative to the home directory.
## Owner: doc 13. Restart required.
# path = "data/flyff.db"
## PRAGMA synchronous; NORMAL with WAL loses at most the last commits on power loss, FULL none.
## Values: "normal" | "full". Owner: doc 13. Restart required.
# synchronous = "normal"
## SQLite busy timeout of every connection (CLI processes and readers).
## Owner: doc 13. Restart required.
# busy_timeout_ms = 5000
## Page cache of the writer connection in MiB (readers use 16).
## Values: >= 1. Owner: doc 13. Restart required.
# cache_size_mib = 64
## Number of read-only connections/threads (lobby queries, game reads, backups).
## Values: 1..=4. Owner: doc 13. Restart required.
# read_connections = 1
## Writer drain limit: commands per transaction.
## Values: >= 1. Owner: doc 13. Restart required.
# batch_max_commands = 256
## Writer drain window after the first command of a batch.
## Owner: doc 13. Restart required.
# batch_max_wait_ms = 20
## How long enter-world waits for the previous session's logout save.
## Owner: doc 13. Restart required.
# flush_wait_timeout_ms = 5000
## Size of one item serial block reserved from meta.next_item_serial.
## Values: >= 1. Owner: doc 13. Restart required.
# serial_block_size = 10000
## Periodic PASSIVE WAL checkpoint interval.
## Owner: doc 13. Restart required.
# checkpoint_interval_s = 300
## Integrity check at start: quick_check or integrity_check.
## Values: "off" | "quick" | "full". Owner: doc 13. Restart required.
# check_on_start = "quick"

[save]
## Periodic snapshot interval per online character (the legacy SEC_SAVEPLAYER).
## Values: >= 1. Owner: doc 13. Restart required.
# interval_s = 90
## Cap of periodic snapshots per 66.7 ms tick (spreads characters that joined together).
## Values: >= 1. Owner: doc 13. Restart required.
# max_periodic_per_tick = 8
## Minimum distance between two urgent snapshots of one character.
## Owner: doc 13. Restart required.
# urgent_min_interval_ms = 1000
## Take a snapshot when the character changes world id.
## Owner: doc 13. Restart required.
# on_world_change = true

[backup]
## Backup directory, relative to the home directory.
## Owner: doc 13. Restart required.
# dir = "backups"
## Scheduled online backup interval in minutes.
## Owner: doc 13. Restart required.
# interval_min = 60
## Hourly backups kept by the grandfather-father-son rotation.
## Owner: doc 13. Restart required.
# keep_hourly = 24
## Daily backups kept.
## Owner: doc 13. Restart required.
# keep_daily = 7
## Weekly backups kept.
## Owner: doc 13. Restart required.
# keep_weekly = 4
## Pre-migration backups kept.
## Owner: doc 13. Restart required.
# keep_premigrate = 5
## Pre-restore backups kept.
## Owner: doc 13. Restart required.
# keep_prerestore = 5
## Shutdown backups kept.
## Owner: doc 13. Restart required.
# keep_shutdown = 5
## Write a backup on graceful shutdown.
## Owner: doc 13. Restart required.
# on_shutdown = false
## Skip a backup when the free disk space is below this factor times the database size.
## Values: >= 0. Owner: doc 13. Restart required.
# min_free_space_factor = 2.0
## Optional command (argv) run after a backup; the backup path and kind are appended.
## Owner: doc 13. Restart required.
# hook = []
## Timeout of the backup hook.
## Owner: doc 13. Restart required.
# hook_timeout_s = 600

[audit]
## Write the append-only JSONL audit log.
## Owner: doc 13. Restart required.
# enabled = true
## Audit log directory, relative to the home directory.
## Owner: doc 13. Restart required.
# dir = "logs/audit"
## Days of audit files kept.
## Owner: doc 13. Restart required.
# retention_days = 90
## Event names or prefixes that are not logged (for example "item.pickup", "session."); admin.* and
## gm.command are never excluded.
## Owner: doc 13. Restart required.
# exclude = []
## Capacity of the bounded audit queue (events are dropped and counted when full).
## Values: >= 1. Owner: doc 13. Restart required.
# queue_capacity = 65536
## Refuse (503 audit_unavailable) an admin console mutation whose audit record cannot be
## acknowledged within 1 s.
## Owner: doc 13. Restart required.
# admin_required = true

[retention]
## Days a soft-deleted character is kept before the purge.
## Owner: doc 13. Restart required.
# deleted_character_days = 7
## Days a soft-deleted mail is kept.
## Owner: doc 13. Restart required.
# deleted_mail_days = 30
## Days a delivered offline note is kept.
## Owner: doc 13. Restart required.
# delivered_note_days = 30
## Days a delivered grant or finished removal is kept.
## Owner: doc 13. Restart required.
# finished_grant_days = 90
## Newest guild bank log rows kept per guild and kind.
## Owner: doc 13. Restart required.
# guild_bank_log_per_kind = 100
## Local hour of the daily maintenance job.
## Values: 0..=23. Owner: doc 13. Restart required.
# maintenance_hour = 5

[rates]
## monster EXP multiplier Unset = Constant.inc formula{} (1.0 for ENG).
## Legacy: prj.m_fMonsterExpRate, GM rate command. Owner: doc 16. Runtime key: GM/admin may change
## it live (kept in runtime_override).
# monster_exp = 1.0  # unset by default
## item drop multiplier Unset = 1.0.
## Legacy: m_fItemDropRate. Owner: doc 19. Runtime key: GM/admin may change it live (kept in
## runtime_override).
# item_drop = 1.0  # unset by default
## gold drop multiplier Unset = 1.0.
## Legacy: m_fGoldDropRate. Owner: doc 19. Runtime key: GM/admin may change it live (kept in
## runtime_override).
# gold_drop = 1.0  # unset by default
## monster hit-rate multiplier Unset = 1.0.
## Legacy: m_fMonsterHitRate. Owner: doc 17. Runtime key: GM/admin may change it live (kept in
## runtime_override).
# monster_hit = 1.0  # unset by default
## NPC shop price multiplier Unset = 1.0.
## Legacy: m_fShopCost (__SHOP_COST_RATE). Owner: doc 19. Runtime key: GM/admin may change it live
## (kept in runtime_override).
# shop_cost = 1.0  # unset by default
## party-level EXP per kill: (monLv/25+1)·10·rate
## Legacy: CoreServer.ini PartyExpRate 10 (code default 1.0). Owner: doc 21. Runtime key: GM/admin
## may change it live (kept in runtime_override).
# party_exp = 10.0
## Madrigal aggressive override (KQ-14)
## Legacy: m_fMonsterAggressiveRate (default 0.2). Ledger: KQ-14. Owner: doc 15. Runtime key:
## GM/admin may change it live (kept in runtime_override).
# monster_aggressive = 0.2

[events]
## "18+ server": PvP/PK case computation, duel/PK menu entries; not settable by /localevent
## Legacy: WorldServer.ini token 18; EventId Eve18 = 1. Owner: doc 17. Runtime key: GM/admin may
## change it live (kept in runtime_override).
# eve_18 = true
## guild bank, guild-house furniture set/remove/reset and tender results, guild-bank cleanup
## Legacy: WorldServer.ini token GUILDBANK; EventId GuildInventory = 2. Owner: doc 21/22. Runtime
## key: GM/admin may change it live (kept in runtime_override).
# guild_bank = true
## guild wars (IsWarTarget, war deaths, duel/PK refusal between war members)
## Legacy: WorldServer.ini token GUILDWAR; EventId GuildWar = 3. Owner: doc 21. Runtime key:
